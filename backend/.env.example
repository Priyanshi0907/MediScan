# MediScan Backend Configuration Template
# Copy this file to .env and set your own values:
# cp .env.example .env

# Groq API Key for high-accuracy predictions, clinical reasoning, and personalized recommendations
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com

# Optional: JWT Secret Key
# MEDISCAN_SECRET_KEY=your_jwt_secret_key_here
